DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Alte Bereichs-URLs dauerhaft (301) auf die neuen URLs weiterleiten.
  # Diese Regeln stehen bewusst vor den Datei-/Verzeichnisprüfungen, weil die
  # alten Verzeichnisse auf dem Server noch existieren können. Unterseiten,
  # optionales index.html und ein vorhandener Querystring werden berücksichtigt
  # (mod_rewrite hängt den Querystring automatisch an das Ziel an).
  RewriteRule ^holzobjekte(?:/index\.html)?/?$ /interior/ [R=301,L]
  RewriteRule ^holzobjekte/([^/.]+)(?:/index\.html)?/?$ /interior/$1/ [R=301,L]
  RewriteRule ^formkultur(?:/index\.html)?/?$ /formcultur/ [R=301,L]
  RewriteRule ^formkultur/([^/.]+)(?:/index\.html)?/?$ /formcultur/$1/ [R=301,L]
  RewriteRule ^materialen(?:/index\.html)?/?$ /materials/ [R=301,L]
  RewriteRule ^materialen/([^/.]+)(?:/index\.html)?/?$ /materials/$1/ [R=301,L]
</IfModule>

# Unbekannte Adressen und fehlende Dateien: Apache liefert 404.html mit echtem
# Status 404 aus (kein interner Rewrite, der als Soft-404 mit HTTP 200 endet).
ErrorDocument 404 /404.html

# AVIF eindeutig mit MIME-Typ ausliefern (sonst fehlt Content-Type, vgl. nosniff).
<IfModule mod_mime.c>
  AddType image/avif .avif
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "\.[a-f0-9]{10,12}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>
